<?xml version="1.0"?>
<package format="2">
  <name>audio_ai_processor</name>
  <version>0.1.0</version>
  <description>
    语音处理节点：海康设备实时取流，KWS 关键词唤醒 + ASR 连续识别，
    模式事件与识别文本发布到 ROS 话题。
  </description>

  <maintainer email="liyun@todo.todo">liyun</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>std_msgs</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>std_msgs</exec_depend>
</package>
