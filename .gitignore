# ===== 构建产物 =====
/build/

# ===== 安装产物 =====
# cmake --install 输出，按需在本机生成
/install/

# ===== 运行产物 =====
# results/ 只保留目录占位，录音与截图不入库
/results/*
!/results/.gitkeep
# log/ 只保留目录占位，实时转写 asr_last_text.txt 不入库
/log/*
!/log/.gitkeep

# ===== 本机维护说明，不入库 =====
/CLAUDE.md

# ===== 离线资源，不入库 =====
# 模型权重与预编译 ORT 库体积大、按平台/模型分发；
# onnxruntime/README.md 保留入库，说明安装与接入方式。
/weight/
/onnxruntime/install/

# ===== Python 缓存（python_ref 自带 .gitignore，这里兜底） =====
__pycache__/
*.py[cod]

# ===== 编辑器 / 系统 =====
.DS_Store
Thumbs.db
