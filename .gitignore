# ===== 构建产物 =====
# 两个库各自独立构建，构建目录都在自己的子目录下
/hk_mic_client/build/
/audio_ai_process/build/
# 旧根工程 build 改名保留的临时目录（确认无用后可删除）
/audio_ai_process/build.legacy/
# catkin 工作区：只入库 catkin_ws/src 下的包，构建与运行产物不入库
/catkin_ws/build/
/catkin_ws/devel/
/catkin_ws/install/
/catkin_ws/log/
/catkin_ws/.catkin_workspace
# catkin_make 自动生成的 toplevel.cmake 符号链接，换机由工具重建
/catkin_ws/src/CMakeLists.txt

# ===== 安装产物 =====
# cmake --install 输出到 3rd/zl_3rd，按需在本机生成
/3rd/zl_3rd/

# ===== 运行产物 =====
# results/ 只保留目录占位，录音与截图不入库
/results/*
!/results/.gitkeep
# log/ 只保留目录占位，实时转写 asr_last_text.txt 不入库
/log/*
!/log/.gitkeep

# ===== 本机维护说明，不入库 =====
/CLAUDE.md

# ===== 离线资源，不入库 =====
# 模型权重与预编译 ORT 库体积大、按平台/模型分发；
# 3rd/onnxruntime/README.md 保留入库，说明安装与接入方式。
/weight/
/3rd/onnxruntime/install/

# ===== Python 缓存（audio_ai_process/python 自带 .gitignore，这里兜底） =====
__pycache__/
*.py[cod]

# ===== 编辑器 / 系统 =====
.DS_Store
Thumbs.db
